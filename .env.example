# Video Studio — copy file này thành .env rồi điền khóa API. KHÔNG đưa .env lên git.

# ── Máy chủ ──
PORT=3001

# ── Model AI (proxy OpenAI-compatible) ──
LLM_BASE_URL=https://api.xah.io/v1
LLM_API_KEY=
LLM_FLASH_MODEL=giabaopro1908/gemini-3.8-flash-high
LLM_CODER_MODEL=gpt-6-luna
LLM_VISION_MODEL=gpt-6-luna
LLM_ASTRA_MODEL=gpt-6-astra
LLM_IMAGE_MODEL=dungcsnd113/gemini-3.1-flash-image
LLM_FLASH_CONCURRENCY=6
LLM_CODER_CONCURRENCY=10
LLM_ASTRA_CONCURRENCY=2
LLM_IMAGE_CONCURRENCY=3
# số lượt vẽ ảnh mỗi video: auto (≈ số cảnh/4 + 2, từ 3 đến 8) hoặc một con số; mỗi lượt ≈ 65 credit
IMAGE_BUDGET=auto
# soát khung hình bằng model vision (true/false)
VISION_REVIEW=true

# ── Giọng đọc (ai33 / Vbee) ──
AI33_API_KEY=
AI33_BASE_URL=https://api.ai33.pro/v3
DEFAULT_VOICE_ENGINE=ai33
DEFAULT_VOICE_ID=vbee_hn_male_minhquan_yt-stable
DEFAULT_VOICE_RATE=0
CAPTIONS=true

# ── Xuất video ──
RENDER_WORKERS=4
RENDER_CRF=18
RENDER_PRESET=medium
# để trống = tự tìm Chrome/Edge
BROWSER_PATH=
